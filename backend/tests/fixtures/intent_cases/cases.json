      {"field": "delivery_days", "operator": "lte", "value": 3, "strength": "hard", "evidence": "delivered within 3 days"}]},
    "expect": {"status": "ready", "missing": [], "conflicts": false, "constraints": [
      {"field": "budget", "operator": "lt", "value": 5000, "strength": "hard"},
      {"field": "brand", "operator": "==", "value": "Nike", "strength": "soft"},
      {"field": "delivery_days", "operator": "lte", "value": 3, "strength": "hard"}]}
  },
