

# Postgres by default; sqlite:///./dev.sqlite also works for local development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aisling

# Gemini API key
# LLM_PROVIDER=groq  (gemini | groq | cerebras | openrouter | openai_compat)
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_BASE_URL=  (only for openai_compat)
LLM_API_KEY=
# Optional second provider for ask-user, discovery query rewrites and the coordinator (keeps the primary under its
# rate limit for intent extraction and evaluator scoring). Leave LLM_LIGHT_PROVIDER unset to use the primary for all.
# LLM_LIGHT_PROVIDER=groq
# LLM_LIGHT_MODEL=qwen/qwen3.8-27b
# LLM_LIGHT_API_KEY=
# Optional stand-in for the primary model while its quota is used up (e.g. Gemini's free daily quota); the primary is
# used again automatically after its reset. The key defaults to LLM_LIGHT_API_KEY when it is the same service.
# LLM_FALLBACK_PROVIDER=groq
# LLM_FALLBACK_MODEL=openai/gpt-oss-120b

# Channel3 product data (https://channel3.ai)
CHANNEL3_API_KEY=

# HMAC keys. Generate each: python -c "import secrets; print(secrets.token_hex(32))"
APPROVAL_SIGNING_KEY=
SESSION_SIGNING_KEY=

# Anonymous sandbox sign-in (local development only; production uses AUTH_JWT_ISSUER/AUDIENCE/JWKS_URL instead)
AUTH_SANDBOX_ENABLED=true

# PayPal sandbox REST app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox business account that receives payments
PAYPAL_PAYEE_MERCHANT_ID=
# Webhook registered in the PayPal app (needed to verify webhook signatures)
PAYPAL_WEBHOOK_ID=
LLM_TIMEOUT_SECONDS=12
LLM_THINKING_BUDGET=0
LLM_TEMPERATURE=0
RUN_LLM_BUDGET_SECONDS=90

# In-app sandbox contractors and remote agents for contractor / A2A runs (false: shopping only)
SANDBOX_COUNTERPARTIES_ENABLED=true
