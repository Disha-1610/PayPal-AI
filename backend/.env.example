APP_NAME=PayPal-AI
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
# Use postgresql://... in production; sqlite:///./dev.sqlite is supported for local development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/paypal_ai
CHECKPOINT_SQLITE_PATH=checkpoints.sqlite
# LLM gateway (provider-independent; supported providers: gemini)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30

# Channel3 product data (https://channel3.ai); key is required for the real connector
CHANNEL3_API_KEY=
CHANNEL3_BASE_URL=https://api.trychannel3.com
CHANNEL3_COUNTRY=
CHANNEL3_CURRENCY=
CHANNEL3_TIMEOUT_SECONDS=10

# Approval signing (HMAC-SHA256). Generate: python -c "import secrets; print(secrets.token_hex(32))"
APPROVAL_SIGNING_KEY=
APPROVAL_KEY_ID=v1
APPROVAL_TTL_SECONDS=600

# PayPal REST app credentials (sandbox by default)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_TIMEOUT_SECONDS=15
PAYPAL_WEBHOOK_ID=
